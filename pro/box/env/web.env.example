DATABASE_URL=postgres://web_rw:<password>@127.0.0.1:5432/ticoncloud?sslmode=verify-full&sslrootcert=/etc/tc/pg-ca.crt
PRO_INVOKE_SOCKET=/run/tc-invoke/invoke.sock
PRO_INVOKE_TOKEN=
APP_ORIGIN=
COGNITO_CUSTOMER_POOL_ID=
COGNITO_CUSTOMER_CLIENT_ID=
# PRO-8: SST links, as SST_RESOURCE_<Name> (the SST SDK reads them). Single quotes: systemd keeps the JSON as is.
SST_RESOURCE_CustomerAppClient='{"id":"","secret":""}'
SST_RESOURCE_CustomerSignUpClient='{"id":"","secret":""}'
SST_RESOURCE_AuthLimitKey='{"value":""}'
SST_RESOURCE_OtpHashKey='{"value":""}'
SST_RESOURCE_OrderDraftSecret='{"value":""}'
