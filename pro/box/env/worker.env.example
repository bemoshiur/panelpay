DATABASE_URL=postgres://worker_rw:<password>@127.0.0.1:5432/ticoncloud?sslmode=verify-full&sslrootcert=/etc/tc/pg-ca.crt
PRO_INVOKE_SOCKET=/run/tc-invoke/invoke.sock
PRO_INVOKE_TOKEN=
TC_PRODUCT_SKU=
# PRO-8: the provisioner, catalog-sync and invoice settings. The account is both the pool and the DNS account.
TC_ENV=production
TC_VPC_CIDR=172.26.0.0/16
TC_PROBE_SOURCES=
TC_DNS_ACCOUNT_ID=
TC_DNS_EXTERNAL_ID=
CATALOG_POOL_ACCOUNT_ID=
CATALOG_REGIONS=ap-southeast-1,ap-south-1,us-east-1
CATALOG_DNS_ACCOUNT_ID=
CATALOG_DNS_EXTERNAL_ID=
INVOICES_BUCKET=
