# root:root 0600. Read only by tc-migrate (installer and updates). The table owner and the five role passwords.
TC_MASTER_URL=postgres://tc_owner:<password>@127.0.0.1:5432/ticoncloud?sslmode=verify-full&sslrootcert=/etc/tc/pg-ca.crt
TC_MIGRATIONS_DIR=/opt/tc/current/migrations
TC_DB_PASSWORD_WEB_RW=
TC_DB_PASSWORD_ADMIN_RW=
TC_DB_PASSWORD_WORKER_RW=
TC_DB_PASSWORD_MIGRATOR=
TC_DB_PASSWORD_REPORT_RO=
TC_FIRST_ADMIN_SUB=
# PRO-8: registers this account as the one pool account (packages/db/seed-pool.ts, stage pro).
TC_POOL_ACCOUNT_IDS=
TC_POOL_EXTERNAL_ID=
