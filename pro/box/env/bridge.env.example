# Only when the WHMCS bridge is set up (PRO-6). The bridge connects as web_rw: the same rights as the
# panel's EPS return, which also credits wallets (insert payments, read customers and markets).
DATABASE_URL=postgres://web_rw:<password>@127.0.0.1:5432/ticoncloud?sslmode=verify-full&sslrootcert=/etc/tc/pg-ca.crt
WHMCS_URL=
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
TC_BRIDGE_SECRET=
