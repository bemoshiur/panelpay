[Unit]
Description=TryAWS.now Pro: Caddy (the only public listener)
After=network-online.target tc-web.service tc-admin.service tc-firewall.service
Wants=network-online.target
Requires=tc-firewall.service

[Service]
Type=notify
User=caddy
Group=caddy
# Our own unit, not Ubuntu's: no `--environ` (it prints the environment to the journal, review L6).
EnvironmentFile=/etc/tc/caddy.env
Environment=XDG_DATA_HOME=/var/lib/tc-caddy XDG_CONFIG_HOME=/var/lib/tc-caddy
ExecStart=/usr/local/bin/caddy run --config /etc/tc/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=1048576
StateDirectory=tc-caddy
StateDirectoryMode=0700

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Security review H2: Caddy needs no AWS credentials either.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
