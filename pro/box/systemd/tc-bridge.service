[Unit]
Description=TryAWS.now Pro: WHMCS bridge (credits paid WHMCS top-up invoices, PRO-6)
After=network-online.target postgresql.service tc-firewall.service
Wants=network-online.target
Requires=postgresql.service tc-firewall.service
# Off until the buyer set up the WHMCS bridge in the installer.
ConditionPathExists=/etc/tc/bridge.env

[Service]
Type=simple
User=tc-bridge
Group=tc-bridge
# Member of caddy's group only to hand Caddy the socket (chgrp after listen, mode 0660). The bridge's own
# files keep its own group (security review L6).
SupplementaryGroups=caddy
WorkingDirectory=/opt/tc/current/bridge
EnvironmentFile=/etc/tc/common.env
EnvironmentFile=/etc/tc/bridge.env
Environment=NODE_ENV=production TC_BRIDGE_SOCKET=/run/tc-bridge/bridge.sock
ExecStart=/usr/bin/node bridge.mjs
Restart=on-failure
RestartSec=5
MemoryMax=300M
RuntimeDirectory=tc-bridge
# 0755 so Caddy can reach the socket; the socket itself is 0660, group caddy.
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The bridge needs no AWS credentials (security review H2).
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
