[Unit]
Description=TryAWS.now Pro: worker (provisioning queue, jobs, invoke socket)
After=network-online.target postgresql.service tc-firewall.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=tc-worker
Group=tc
WorkingDirectory=/opt/tc/current/worker
EnvironmentFile=/etc/tc/common.env
EnvironmentFile=/etc/tc/worker.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node main.mjs
Restart=on-failure
RestartSec=5
# The worker waits for runs in progress on SIGTERM (pro/worker/main.ts); a provisioning step is <= 60 s.
TimeoutStopSec=90
MemoryMax=900M

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
# PRO-5: /var/lib/tc/licence.json (the licence status; the update gate reads it).
StateDirectory=tc
StateDirectoryMode=0755
# The invoke socket (PRO-2): created by the worker only; the web tier (group tc) may connect.
RuntimeDirectory=tc-invoke
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
