[Unit]
Description=PanelPay Pro: nightly database backup
After=postgresql.service
Requires=postgresql.service
OnSuccess=tc-backup-s3.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/tc/backup.env
ExecStart=/opt/tc/current/box/bin/tc-backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tc
UMask=0077
# Security review M1 of PRO-8: postgres never reaches the instance role.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
