[Unit]
Description=TryAWS.now Pro: nightly database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/tc/backup.env
ExecStart=/opt/tc/current/box/bin/tc-backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tc
UMask=0077
